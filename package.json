{
  "name": "gorkie",
  "license": "AGPL-3.0-only",
  "description": "An AI assistant for Slack, built on Mastra.",
  "type": "module",
  "module": "src/mastra/index.ts",
  "private": true,
  "patchedDependencies": {
    "@mastra/core@1.59.0": "patches/@mastra+core@1.59.0.patch"
  },
  "scripts": {
    "dev": "mastra dev --request-context-presets ./studio/request-context.json",
    "build": "mastra build",
    "postbuild": "bun run scripts/postbuild.ts && cd .mastra/output && bun install",
    "start": "mastra start",
    "build:template": "bun run src/mastra/workspace/build-template.ts",
    "typecheck": "tsc --noEmit",
    "check": "ultracite check .",
    "check:spelling": "cspell -c .cspell.jsonc --no-progress --no-summary --no-must-find-files --unique --cache .",
    "check:unsafe": "ultracite fix --unsafe .",
    "fix": "ultracite fix .",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^3.0.29",
    "@ai-sdk/provider-utils": "^5.0.26",
    "@chat-adapter/slack": "^4.35.0",
    "@mastra/core": "^1.59.0",
    "@mastra/duckdb": "1.6.1",
    "@mastra/e2b": "0.8.2",
    "@mastra/loggers": "1.2.0",
    "@mastra/mcp": "^1.16.0",
    "@mastra/memory": "^1.26.2",
    "@mastra/observability": "1.17.0",
    "@mastra/pg": "1.20.0",
    "@t3-oss/env-core": "^0.13.11",
    "ai": "^7.0.66",
    "chat": "^4.35.0",
    "dotenv": "^17.4.2",
    "e2b": "^2.36.1",
    "exa-js": "^2.16.3",
    "mime-types": "^3.0.2",
    "zod": "^4"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@commitlint/cli": "^21.2.0",
    "@commitlint/config-conventional": "^21.2.0",
    "@commitlint/types": "^21.2.0",
    "@types/bun": "latest",
    "@types/mime-types": "^3.0.1",
    "@types/node": "^24",
    "cspell": "^10.0.1",
    "lefthook": "^2.1.10",
    "mastra": "^1.25.0",
    "typescript": "^6.0.3",
    "ultracite": "7.9.4"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
